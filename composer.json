{
    "name": "davidtav/sabores-do-norte",
    "description": "Site e painel administrativo do restaurante Sabores do Norte (PHP MVC sem framework)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "davidtav",
            "email": "david.mclaurel@outlook.com.br"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3"
    }
}
